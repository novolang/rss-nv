// `f` with its last-changed stamp set.
//
// ```novo
// use civil
// use rssfeed
//
// fn main() [io]
//     match civil.date(2026, 9, 11)
//         Ok(d)  =>
//             let s = rssfeed.stamp(civil.datetime(d, civil.midnight()), 0)
