// rssfeed.nv — one feed value, whatever the format on the wire was.
//
// Every body here is a `todo()`; the signatures are the design.
//
// THE POINT OF THE PACKAGE IS THIS FILE.  RSS 2.0, Atom 1.0 and JSON
// Feed 1.1 describe the same thing three times with three vocabularies,
// and a program that reads feeds does not want to know which one it
// got.  So the readers all produce an `RssFeed` and the writers all
// consume one, and the format survives only as a label on the read
// (`RssRead.format`) for the caller that wants to write back what it
// read.
//
// EVERY HUMAN-READABLE STRING IS AN `RssText`, NEVER A `Str`.  That is
// the load-bearing decision and it is worth the extra type at every
// call site.  RSS 2.0's `<description>` is escaped HTML by universal
// convention and by no specification.  Atom says which it is, in an
// attribute, three ways: `type="text"`, `type="html"` and
// `type="xhtml"`.  JSON Feed splits it into two fields, `content_text`
// and `content_html`, and says an item may carry either or both.  One
// question, three spellings — and a reader that flattened them to
// `Str` hands its caller a string that cannot be rendered safely in
// either direction: escaping it shows `<p>` to the end user, not
// escaping it is stored cross-site scripting from whatever the feed
// said.  So the type travels with the text, and a consumer that
// renders has to look at it.
//
// NOTHING HERE IS OPTIONAL-OF-A-VALUE-STRUCT.  SPEC § 14.5 refuses a
// `@value` struct as an optional payload, and a feed is full of fields
// that are genuinely absent — an entry with no publication date, a
// feed with no icon.  So no struct in this file is `@value`: they are
// ordinary structs, they allocate, and `?RssStamp` is a legal type.
// The package makes no device claim, and the reason is in the manifest.
//
// A LIST IS EMPTY, NOT ABSENT.  `authors`, `links`, `categories` and
// `enclosures` are lists, and a feed that named none has a list of
// length zero.  Only a scalar that a format genuinely marks as present
// or missing is an `?`.

use civil

// How to read the characters in an `RssText`.
//
// The three are Atom's, because Atom is the only one of the three
// formats that states the question; the readers for the other two map
// onto it and the notes say where they guessed.
pub enum RssTextType
    // Characters, to be shown as they are.  Atom `type="text"`, JSON
    // Feed's `title` and `content_text`.
    RssTextPlain
    // A fragment of HTML, escaped in the source.  Atom `type="html"`,
    // JSON Feed's `content_html`, and RSS 2.0's `<description>` and
    // `<content:encoded>` by convention.
    RssTextHtml
    // A fragment of XHTML that was live markup in the source rather
    // than escaped text.  Atom `type="xhtml"` only; the reader has
    // already serialised the `<div>`'s children into `text`.
    RssTextXhtml

// A string and how to read it.
//
// `base` is the URI that relative references inside `text` resolve
// against — `xml:base` in an XML feed, `home_page_url` in a JSON one —
// and it is carried rather than applied because rewriting somebody's
// markup is not a parser's job.  `lang` is `xml:lang` or JSON Feed's
// `language`, empty when the feed did not say.
pub struct RssText
    // The characters, already entity-decoded for the XML formats.
    text: Str
    // How to read them.
    kind: RssTextType
    // What a relative reference inside `text` is relative to, or the
    // empty string when nothing established one.
    base: Str
    // BCP 47 language tag, or the empty string.
    lang: Str

// A link out of a feed or an entry.
//
// Atom has as many of these as it likes and distinguishes them by
// `rel`; RSS 2.0 has one `<link>` and a `<guid isPermaLink="true">`
// that is also one, and a great many RSS feeds borrow Atom's
// `<atom:link rel="self">` for their own address because RSS has no
// way to state it.  So the reader produces a list for every format and
// `link_with_rel` is how a caller asks for the one it wanted.
pub struct RssLink
    // The reference exactly as the feed wrote it — relative if it was
    // relative.  `rssread.RssOptions.resolve_relative` decides whether
    // the reader has already joined it to `base`.
    href: Str
    // `alternate`, `self`, `enclosure`, `related`, `via`, `hub`,
    // `next`, `prev`.  An Atom link with no `rel` is `alternate`, and
    // the reader has already filled that in — RFC 4287 § 4.2.7.2.
    rel: Str
    // The `type` attribute: an advertised media type, or empty.
    mime: Str
    // The `title` attribute, or empty.
    title: Str
    // The `hreflang` attribute, or empty.
    hreflang: Str
    // The `length` attribute in bytes, or `0` when absent.  Advisory
    // in every format that has it, and frequently wrong.
    length: Int

// A person: Atom's `atom:author`, RSS's `<managingEditor>` and
// `<author>`, JSON Feed 1.1's `authors` array.
//
// RSS's two elements are an address with an optional parenthesised
// name — `ada@example.com (Ada Lovelace)` — and the reader splits
// them; the note says it did.
pub struct RssPerson
    // The display name, or empty.
    name: Str
    // The address, or empty.
    email: Str
    // A home page, or empty.  Atom's `atom:uri`, JSON Feed's `url`.
    uri: Str

// A category, tag or subject.
pub struct RssCategory
    // The machine-readable value.  RSS's element text, Atom's `term`,
    // JSON Feed's array element.
    term: Str
    // The vocabulary the term is from: RSS's `domain` attribute,
    // Atom's `scheme`.  Empty when unstated.
    scheme: Str
    // A human-readable form of `term`, or empty.  Atom's `label`.
    label: Str

// A file hanging off an entry: RSS 2.0's `<enclosure>`, Atom's
// `rel="enclosure"` link, JSON Feed's `attachments`.
//
// Kept as its own type rather than folded into `RssLink` because
// exactly one of the three formats treats it as a link, and a podcast
// client asking "what are the audio files" should not have to filter
// a list of links by `rel` and hope.
pub struct RssEnclosure
    // Where the file is.
    url: Str
    // The advertised media type; empty when the feed did not say,
    // which RSS 2.0 requires and many feeds omit.
    mime: Str
    // Size in bytes, or `0` when absent.  Advisory.
    length: Int
    // JSON Feed's `duration_in_seconds`, or `0`.  The other two
    // formats carry this only in the iTunes extension, which this
    // package does not read.
    duration_s: Int
    // JSON Feed's `title`, or empty.
    title: Str

// A moment a feed stamped something with, and how far from UTC the
// feed wrote it.
//
// The civil date-time and the offset are kept apart rather than
// normalised to UTC because a feed's own offset is information — it is
// how a reader shows "posted 09:00 local" — and because normalising
// would make `read` then `write` change bytes that were correct.
// `rssdate` is where the strings become one of these.
pub struct RssStamp
    // The wall-clock date and time the feed wrote.
    at: CivilDateTime
    // Minutes east of UTC, so `+01:00` is `60` and `-0500` is `-300`.
    // A feed that wrote `Z`, `GMT` or `UT` gives `0`.
    offset_min: Int

// One item or entry.
pub struct RssEntry
    // A stable identity for the entry.  Atom's `atom:id`, RSS's
    // `<guid>`, JSON Feed's `id`, which 1.1 requires.  An RSS feed
    // with no `<guid>` leaves this empty and the read carries a
    // `RssNoteSyntheticId` note saying what was used instead.
    id: Str
    // Whether `id` is also a URL that can be fetched.  RSS's
    // `isPermaLink`, which defaults to true and which most feeds that
    // mean false forget to set.
    id_is_permalink: Bool
    // The entry's title.  Required by Atom, optional in the other two;
    // an entry that had none has an empty `RssText`.
    title: RssText
    // Every link the entry carried, `rel` filled in.
    links: [RssLink]
    // A short form: Atom's `atom:summary`, RSS's `<description>` when
    // `<content:encoded>` was also present, JSON Feed's `summary`.
    summary: ?RssText
    // The full text: Atom's `atom:content`, RSS's `<content:encoded>`
    // or its `<description>` when that was all there was, JSON Feed's
    // `content_html` or `content_text`.
    content: ?RssText
    // Who wrote it.
    authors: [RssPerson]
    // Who else worked on it.  Atom only.
    contributors: [RssPerson]
    // Tags.
    categories: [RssCategory]
    // When it first appeared.  Atom's `atom:published`, RSS's
    // `<pubDate>`, JSON Feed's `date_published`.
    published: ?RssStamp
    // When it last changed.  Atom's `atom:updated`, which Atom
    // requires; JSON Feed's `date_modified`; RSS has none, so an RSS
    // entry's `updated` is `None` rather than a copy of `published`.
    updated: ?RssStamp
    // Files hanging off the entry.
    enclosures: [RssEnclosure]
    // Licensing text, or `None`.  Atom's `atom:rights`.
    rights: ?RssText
    // The feed the entry says it came from, when it says: Atom's
    // `atom:source/atom:id`, RSS's `<source url=…>`.  Empty otherwise.
    source_id: Str
    // JSON Feed's `url`, or the `rel="alternate"` link's href — the
    // one address a reader opens when somebody clicks the entry.
    // Empty when the entry named none.
    url: Str
    // JSON Feed's `external_url`, or empty.  A link blog's "the thing
    // I am linking to", which is a different address from `url`.
    external_url: Str
    // JSON Feed's `image`, or empty.
    image: Str
    // JSON Feed's `banner_image`, or empty.
    banner_image: Str
    // JSON Feed 1.1's `language` for this item, or empty.
    lang: Str

// A whole feed.
pub struct RssFeed
    // A stable identity for the feed.  Atom's `atom:id`, JSON Feed's
    // `feed_url`.  RSS has none; an RSS read leaves it empty rather
    // than inventing one.
    id: Str
    // The feed's title.
    title: RssText
    // A longer description: Atom's `atom:subtitle`, RSS's
    // `<description>`, JSON Feed's `description`.
    subtitle: ?RssText
    // Every link the feed carried.  `rel="self"` is the feed's own
    // address and `rel="alternate"` is the site it belongs to.
    links: [RssLink]
    // Who publishes it.
    authors: [RssPerson]
    // Who else.  Atom only.
    contributors: [RssPerson]
    // Feed-level tags.
    categories: [RssCategory]
    // When the feed last changed.  Atom's `atom:updated`, RSS's
    // `<lastBuildDate>`, JSON Feed has none.
    updated: ?RssStamp
    // When the feed was published, when it says so.  RSS's
    // `<pubDate>`; Atom has no feed-level equivalent.
    published: ?RssStamp
    // What produced the feed, or empty.
    generator: Str
    // A small square image: Atom's `atom:icon`, JSON Feed's `favicon`.
    icon: Str
    // A larger one: Atom's `atom:logo`, RSS's `<image><url>`, JSON
    // Feed's `icon`.
    logo: Str
    // Licensing text, or `None`.
    rights: ?RssText
    // BCP 47 language tag, or empty.
    language: Str
    // RSS's `<ttl>` in minutes, or `0`.  Advisory, and no other format
    // has it.
    ttl_minutes: Int
    // JSON Feed's `next_url`, or a `rel="next"` link — the older page
    // of a paginated feed.  Empty when there is none.
    next_url: Str
    // JSON Feed 1.1's `expired`: the publisher has said this feed will
    // never be updated again, so a reader may stop polling it.  False
    // for the XML formats, which have no way to say it.
    expired: Bool
    // The entries, in the order the feed wrote them, which is not
    // necessarily newest first and which no format requires to be.
    entries: [RssEntry]

// Which serialisation a feed was read from or is to be written to.
pub enum RssFormat
    // RSS 2.0, and 0.91 / 0.92 / 0.93 / 0.94, which the reader treats
    // as a subset of it.
    RssFormatRss20
    // Atom 1.0, RFC 4287.
    RssFormatAtom10
    // JSON Feed 1.1.
    RssFormatJson11
    // Nothing this package reads.  `rssread.sniff` answers this for
    // RSS 1.0 / RDF and Atom 0.3, both of which are refused by name
    // rather than approximated.
    RssFormatUnknown

// ── building a feed ──────────────────────────────────────────────────
//
// A struct literal cannot be written from another module, so every
// type above has a constructor here and the two large ones — the feed
// and the entry — are built by starting empty and threading `with_`
// calls.  That is also the shape a program generating a feed out of
// its own records wants: it has a list of posts, not a literal.

// A feed with nothing in it — the starting value a program building a
// feed from its own records appends to.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println("[${rssfeed.empty_feed().title.text}]")
// ```
pub fn empty_feed() -> RssFeed []
    todo("rss-nv.rssfeed.empty_feed")

// An entry with nothing in it.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println("[${rssfeed.empty_entry().id}]")
// ```
pub fn empty_entry() -> RssEntry []
    todo("rss-nv.rssfeed.empty_entry")

// Characters, to be shown as they are.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.plain("hello").text)
// ```
pub fn plain(s: Str) -> RssText []
    todo("rss-nv.rssfeed.plain")

// A fragment of HTML.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.html("<p>hi</p>").text)
// ```
pub fn html(s: Str) -> RssText []
    todo("rss-nv.rssfeed.html")

// A fragment of XHTML, already serialised out of its wrapper `<div>`.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.xhtml("<p>hi</p>").text)
// ```
pub fn xhtml(s: Str) -> RssText []
    todo("rss-nv.rssfeed.xhtml")

// A text with a base URI and a language attached.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     let t = rssfeed.text_in("hi", RssTextPlain, "https://example.com/", "en")
//     println(t.base)
// ```
pub fn text_in(s: Str, kind: RssTextType, base: Str, lang: Str) -> RssText []
    todo("rss-nv.rssfeed.text_in")

// A link.  `rel` empty means `alternate`, which is what RFC 4287
// § 4.2.7.2 says an Atom link with no `rel` attribute is.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.link("https://example.com/", "alternate", "text/html").href)
// ```
pub fn link(href: Str, rel: Str, mime: Str) -> RssLink []
    todo("rss-nv.rssfeed.link")

// A link with every attribute the formats carry.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     let l = rssfeed.link_full("https://example.com/", "self",
//                               "application/atom+xml", "Feed", "en", 0)
//     println(l.rel)
// ```
pub fn link_full(href: Str, rel: Str, mime: Str, title: Str, hreflang: Str,
                 length: Int) -> RssLink []
    todo("rss-nv.rssfeed.link_full")

// A person.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.person("Ada", "ada@example.com", "").name)
// ```
pub fn person(name: Str, email: Str, uri: Str) -> RssPerson []
    todo("rss-nv.rssfeed.person")

// A category.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.category("novo-lang", "", "").term)
// ```
pub fn category(term: Str, scheme: Str, label: Str) -> RssCategory []
    todo("rss-nv.rssfeed.category")

// An enclosure.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.enclosure("https://example.com/a.mp3", "audio/mpeg", 1024).mime)
// ```
pub fn enclosure(url: Str, mime: Str, length: Int) -> RssEnclosure []
    todo("rss-nv.rssfeed.enclosure")

// A stamp: a civil date-time and how far east of UTC the feed wrote it.
//
// ```novo
// use civil
// use rssfeed
//
// fn main() [io]
//     match civil.date(2026, 9, 11)
//         Ok(d)  => println("${rssfeed.stamp(civil.datetime(d, civil.midnight()), 60).offset_min}")
//         Err(_) => println("no")
// ```
pub fn stamp(at: CivilDateTime, offset_min: Int) -> RssStamp []
    todo("rss-nv.rssfeed.stamp")

// `f` with its identity set.
//
// ```novo
// use rssfeed
//
// fn main() [io]
//     println(rssfeed.with_id(rssfeed.empty_feed(), "urn:example:feed").id)
