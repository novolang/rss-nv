// `e` with one more link.
//
// ```novo
// use std.list
// use rssfeed
//
// fn main() [io]
//     let l = rssfeed.link("https://example.com/1", "alternate", "text/html")
//     println("${list.len(rssfeed.entry_push_link(rssfeed.empty_entry(), l).links)}")
// ```
pub fn entry_push_link(e: RssEntry, l: RssLink) -> RssEntry []
